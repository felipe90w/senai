import socket


def scanner_port(host, port):
    cliente = socket.socket()
    try:
        cliente.connect((host, port))
        resultado = cliente.connect_ex((host, port))
        if resultado == 0:
            print("Porta se encontra aberta")
        else:
            print("Porta Fechada")
    finally:
        cliente.close()


